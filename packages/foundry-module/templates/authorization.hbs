<section class="standard-form">
  <div class="form-group fvtt-world-cli-readonly">
    <label>{{localize "FVTTWORLDCLI.BridgeStatus.Connection"}}</label>
    <div class="form-fields">
      <strong class="fvtt-world-cli-status--{{displayState}}">{{connectionLabel}}</strong>
    </div>
  </div>
  <div class="form-group fvtt-world-cli-readonly">
    <label>{{localize "FVTTWORLDCLI.BridgeStatus.LocalPairing"}}</label>
    <div class="form-fields">
      <strong>
        {{#if paired}}{{localize "FVTTWORLDCLI.BridgeStatus.Configured"}}{{else}}{{localize
          "FVTTWORLDCLI.BridgeStatus.NotConfigured"}}{{/if}}
      </strong>
    </div>
  </div>
  <div class="form-group {{#unless clientLabelEditable}}fvtt-world-cli-readonly{{/unless}}">
    <label for="fvtt-world-cli-client-label">{{localize "FVTTWORLDCLI.Authorization.ClientLabel"}}</label>
    <div class="form-fields">
      <input id="fvtt-world-cli-client-label" type="text" name="clientLabel" value="{{clientLabel}}"
        maxlength="{{clientLabelMaxLength}}" data-tooltip="{{localize clientLabelTooltip}}"
        {{#unless clientLabelEditable}}readonly{{/unless}} />
    </div>
  </div>
  {{#if isGM}}
  <footer class="form-footer">
    {{#unless paired}}<button type="button" data-action="pair"><i class="fa-solid fa-link"></i> {{localize
        "FVTTWORLDCLI.Authorization.Pair"}}</button>{{/unless}}
    {{#if paired}}<button type="button" data-action="{{connectionAction}}" class="fvtt-world-cli-connection-action"><i
        class="fa-solid {{connectionActionGlyph}}"></i> {{localize connectionActionLabel}}</button>{{/if}}
    {{#if paired}}<button type="button" data-action="unpair"><i class="fa-solid fa-link-slash"></i> {{localize
        "FVTTWORLDCLI.Authorization.Unpair"}}</button>{{/if}}
    {{#if paired}}<button type="button" data-action="forget"><i class="fa-solid fa-trash"></i> {{localize
        "FVTTWORLDCLI.Authorization.Forget"}}</button>{{/if}}
  </footer>
  {{else}}<p>{{localize "FVTTWORLDCLI.Authorization.GMOnly"}}</p>{{/if}}
</section>
